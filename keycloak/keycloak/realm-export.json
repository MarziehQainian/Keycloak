{
  "realm": "demo",
  "enabled": true,
  "displayName": "Keycloak Demo",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Demo API user"
      },
      {
        "name": "admin",
        "description": "Demo API administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "keycloak-demo-api",
      "name": "Keycloak Demo API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "keycloak-demo-swagger",
      "name": "Keycloak Demo Swagger",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5099/swagger/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:5099"
      ],
      "protocolMappers": [
        {
          "name": "Keycloak Demo API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "keycloak-demo-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "email": "demo-user@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "user-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    },
    {
      "username": "demo-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Administrator",
      "email": "demo-admin@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "admin-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "admin"
      ]
    }
  ]
}
